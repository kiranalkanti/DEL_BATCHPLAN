 FROM #PsetNeDmaConnection.$DB2SchemaNameIds#.T_PROVR_ENROLLMENT
 WHERE EFFV_END_DATE = '9999-12-31'  AND FILE_TYPE = '#FILE_TYPE#'
 
 Union All
 SELECT distinct GRP_MBR_PROVR_ID AS PROVR_ID,BEGIN_EFFV_DT AS ELIGIBLE_FROM,END_EFFV_DT AS ELIGIBLE_TO 
 FROM #PsetNeDmaConnection.$DB2SchemaNameIds#.T_GROUP_PROVR
 )
