 Union All 
 SELECT distinct PROVR_ID, PROVR_TAXONOMY_CLS_EFFV_DT AS ELIGIBLE_FROM, PROVR_TAXONOMY_CLS_END_DT AS ELIGIBLE_TO
 FROM #PsetNeDmaConnection.$DB2SchemaNameIds#.T_PROVR_TAXONOMY_CLASS 
 WHERE EFFV_END_DATE = '9999-12-31'  AND FILE_TYPE = '#FILE_TYPE#'

 Union All 
