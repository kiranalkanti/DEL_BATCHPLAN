      DSSQLPrecision={PROVR_ID=50, ELIGIBLE_FROM=10, ELIGIBLE_TO=10, NEXT_DATE=10, PREV_DATE=10, DATA_SOURCE=200}, 
      DSSchema=\\'record
         (
