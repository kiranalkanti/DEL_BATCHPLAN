#### STAGE: Db_Provr_Tx
## Operator
pxbridge
## Operator options
-Orientation link
-XMLProperties '<?xml version=\\'1.0\\' encoding=\\'UTF-16\\'?><Properties version=\\'1.1\\'><Common><Context type=\\'int\\'>1</Context><Variant type=\\'string\\'>9.1</Variant><DescriptorVersion type=\\'string\\'>1.0</DescriptorVersion><PartitionType type=\\'int\\'>-1</PartitionType><RCP type=\\'int\\'>0</RCP></Common><Connection><Instance modified=\\'1\\' type=\\'string\\'><![CDATA[[&"PsetNeDmaConnection.$DB2Instance"]]]></Instance><Database modified=\\'1\\' type=\\'string\\'><![CDATA[[&"PsetNeDmaConnection.$DB2Name"]]]></Database><Username modified=\\'1\\' type=\\'string\\'><![CDATA[[&"PsetNeDmaConnection.$DB2UserName"]]]></Username><Password modified=\\'1\\' type=\\'string\\'><![CDATA[[&"PsetNeDmaConnection.$DB2Password"]]]></Password><Conductor collapsed=\\'1\\' type=\\'bool\\'><![CDATA[0]]></Conductor><UseDirectConnections type=\\'bool\\'><![CDATA[0]]></UseDirectConnections><KeepConductorConnectionAlive type=\\'bool\\'><![CDATA[1]]></KeepConductorConnectionAlive></Connection><Usage><MigratedJob type=\\'bool\\'><![CDATA[0]]></MigratedJob><GenerateSQL type=\\'bool\\'><![CDATA[0]]></GenerateSQL><EnableQuotedIDs type=\\'bool\\'><![CDATA[0]]></EnableQuotedIDs><XMLColumnAsLOB type=\\'bool\\'><![CDATA[0]]></XMLColumnAsLOB><PrefixForExpressionColumns type=\\'string\\'><![CDATA[EXPR]]></PrefixForExpressionColumns><SQL><SelectStatement modified=\\'1\\' type=\\'string\\'><![CDATA[  SELECT distinct PROVR_ID, DATE AS ELIGIBLE_FROM, lead(DATE) over  (Partition By PROVR_ID order by PROVR_ID,DATE) AS  ELIGIBLE_TO FROM (
 SELECT distinct PROVR_ID, DATE FROM (
 SELECT distinct PROVR_ID, ELIGIBLE_FROM AS DATE
 FROM (
 SELECT distinct PROVR_ID, ELIGIBLE_FROM, ELIGIBLE_TO
 FROM [&"PsetNeDmaConnection.$DB2SchemaNameIds"].T_PROVR_ELGT 
 WHERE EFFV_END_DATE = \\'9999-12-31\\'  AND FILE_TYPE = \\'[&"FILE_TYPE"]\\'
 
 Union All 
 SELECT distinct PROVR_ID, PROVR_TAXONOMY_CLS_EFFV_DT AS ELIGIBLE_FROM, PROVR_TAXONOMY_CLS_END_DT AS ELIGIBLE_TO
 FROM [&"PsetNeDmaConnection.$DB2SchemaNameIds"].T_PROVR_TAXONOMY_CLASS 
 WHERE EFFV_END_DATE = \\'9999-12-31\\'  AND FILE_TYPE = \\'[&"FILE_TYPE"]\\'

 Union All 
 SELECT distinct PROVR_ID, PROVR_ENRL_EFFV_DT AS ELIGIBLE_FROM, PROVR_ENRL_END_DT AS ELIGIBLE_TO
 FROM [&"PsetNeDmaConnection.$DB2SchemaNameIds"].T_PROVR_ENROLLMENT
 WHERE EFFV_END_DATE = \\'9999-12-31\\'  AND FILE_TYPE = \\'[&"FILE_TYPE"]\\'
 
 Union All
 SELECT distinct GRP_MBR_PROVR_ID AS PROVR_ID,BEGIN_EFFV_DT AS ELIGIBLE_FROM,END_EFFV_DT AS ELIGIBLE_TO 
 FROM [&"PsetNeDmaConnection.$DB2SchemaNameIds"].T_GROUP_PROVR
 )
 Union All
 SELECT distinct PROVR_ID, ELIGIBLE_TO AS DATE
 FROM (
 SELECT distinct PROVR_ID, ELIGIBLE_FROM, ELIGIBLE_TO
 FROM [&"PsetNeDmaConnection.$DB2SchemaNameIds"].T_PROVR_ELGT 
 WHERE EFFV_END_DATE = \\'9999-12-31\\'  AND FILE_TYPE = \\'[&"FILE_TYPE"]\\'

 Union All 
 SELECT distinct PROVR_ID, PROVR_TAXONOMY_CLS_EFFV_DT AS ELIGIBLE_FROM, PROVR_TAXONOMY_CLS_END_DT AS ELIGIBLE_TO
 FROM [&"PsetNeDmaConnection.$DB2SchemaNameIds"].T_PROVR_TAXONOMY_CLASS 
 WHERE EFFV_END_DATE = \\'9999-12-31\\'  AND FILE_TYPE = \\'[&"FILE_TYPE"]\\'
 
 Union All 
 SELECT distinct PROVR_ID, PROVR_ENRL_EFFV_DT AS ELIGIBLE_FROM, PROVR_ENRL_END_DT AS ELIGIBLE_TO
 FROM [&"PsetNeDmaConnection.$DB2SchemaNameIds"].T_PROVR_ENROLLMENT
 WHERE EFFV_END_DATE = \\'9999-12-31\\'  AND FILE_TYPE = \\'[&"FILE_TYPE"]\\'
 
 Union All
 SELECT distinct GRP_MBR_PROVR_ID AS PROVR_ID,BEGIN_EFFV_DT AS ELIGIBLE_FROM,END_EFFV_DT AS ELIGIBLE_TO 
 FROM [&"PsetNeDmaConnection.$DB2SchemaNameIds"].T_GROUP_PROVR
 )
 ) ORDER BY DATE ASC
 );]]><ReadFromFileSelect type=\\'bool\\'><![CDATA[0]]></ReadFromFileSelect><Tables collapsed=\\'1\\'></Tables><Parameters collapsed=\\'1\\'></Parameters><Columns collapsed=\\'1\\'></Columns></SelectStatement><EnablePartitioning collapsed=\\'1\\' type=\\'bool\\'><![CDATA[0]]></EnablePartitioning></SQL><Transaction><RecordCount type=\\'int\\'><![CDATA[2000]]></RecordCount><EndOfWave collapsed=\\'1\\' type=\\'int\\'><![CDATA[0]]></EndOfWave></Transaction><Session><IsolationLevel type=\\'int\\'><![CDATA[1]]></IsolationLevel><AutocommitMode type=\\'int\\'><![CDATA[0]]></AutocommitMode><ArraySize type=\\'int\\'><![CDATA[2000]]></ArraySize><SchemaReconciliation><FailOnSizeMismatch type=\\'bool\\'><![CDATA[1]]></FailOnSizeMismatch><FailOnTypeMismatch type=\\'bool\\'><![CDATA[1]]></FailOnTypeMismatch><FailOnCodePageMismatch type=\\'bool\\'><![CDATA[0]]></FailOnCodePageMismatch></SchemaReconciliation><PassLobLocator collapsed=\\'1\\' type=\\'bool\\'><![CDATA[0]]></PassLobLocator></Session><BeforeAfter collapsed=\\'1\\' type=\\'bool\\'><![CDATA[0]]></BeforeAfter><ReOptimization type=\\'int\\'><![CDATA[2]]></ReOptimization><LockWaitMode collapsed=\\'1\\' type=\\'int\\'><![CDATA[1]]></LockWaitMode><LimitRows collapsed=\\'1\\' type=\\'bool\\'><![CDATA[0]]></LimitRows></Usage></Properties >'
-connector '{
   variant=\\'9.1\\', 
   library=ccdb2, 
   version=1.0, 
   variantlist=\\'V1;9.1::ccdb2\\', 
   versionlist=\\'1.0\\', 
   name=DB2Connector
}'
-source 0 '{
      DSDescription={PROVR_ID=\\'\\<none\\>\\', ELIGIBLE_FROM=\\'\\<none\\>\\'}, 
      DSDisplayWidth={PROVR_ID=20, ELIGIBLE_FROM=10}, 
      DSSQLType={PROVR_ID=12, ELIGIBLE_FROM=9, ELIGIBLE_TO=9}, 
      DSSQLPrecision={PROVR_ID=50, ELIGIBLE_FROM=10, ELIGIBLE_TO=10}, 
      DSSchema=\\'record
         (
           PROVR_ID\\:string\\[max\\=50\\]\\;
           ELIGIBLE_FROM\\:nullable date\\;
           ELIGIBLE_TO\\:nullable date\\;
         )\\'
}'
   

## General options
[ident('Db_Provr_Tx'); jobmon_ident('Db_Provr_Tx')]
## Outputs
0> [modify (
  PROVR_ID:not_nullable string[max=50]=PROVR_ID;
  ELIGIBLE_FROM:nullable date=ELIGIBLE_FROM;
  ELIGIBLE_TO:nullable date=ELIGIBLE_TO;
keep
